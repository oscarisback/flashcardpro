                  "answer": "\u3010\u8b6f\u6587\u3011\u4e0d\u50c5\u8ce2\u80fd\u7684\u4eba\u6709\u9019\u7a2e\u5fc3(\u672c\u5fc3/\u91cd\u7fa9\u4e4b\u5fc3),(1\u5206) \u4eba\u4eba\u90fd\u6709\u9019\u7a2e\u5fc3,(1\u5206) \u53ea\u662f\u8ce2\u80fd\u7684\u4eba\u80fd\u5920\u4e0d\u55aa\u5931\u5b83\u7f77\u4e86\u3002(1\u5206)"
                },
                {
                  "type": "Standard",
                  "question": "\u5b5f\u5b50\u5728\u6587\u7ae0\u958b\u9996\u4ee5\u300c\u9b5a\u300d\u548c\u300c\u718a\u638c\u300d\u4f5c\u6bd4\u55bb,\u8ad6\u8ff0\u4e86\u751a\u9ebc\u9053\u7406?\u8a66\u9ad4\u6703\u5176\u8ad6\u8b49\u6548\u679c\u3002(4\u5206)",
                  "image": null,
                  "interval": 1,
                  "ease_factor": 2.5,
                  "next_review": 1787147148.401962,
                  "answer": "\u2027 \u9053\u7406: \u4ee5\u300c\u9b5a\u300d\u6bd4\u55bb\u300c\u751f\u300d,\u4ee5\u300c\u718a\u638c\u300d\u6bd4\u55bb\u300c\u7fa9\u300d\u3002\u8aaa\u660e\u7576\u300c\u751f\u300d\u8207\u300c\u7fa9\u300d\u5169\u8005\u4e0d\u80fd\u540c\u6642\u517c\u5f97\u6642,\u61c9\n\u8a72\u300c\u6368\u751f\u53d6\u7fa9\u300d\u3002(2\u5206)\n\u2027 \u6548\u679c: \u904b\u7528\u985e\u6bd4\u8ad6\u8b49(\u6bd4\u55bb\u8ad6\u8b49),\u7528\u65e5\u5e38\u751f\u6d3b\u4e2d\u5e38\u898b\u7684\u98f2\u98df\u6289\u64c7(\u9b5a\u8207\u718a\u638c)\u4f5c\u6bd4,\u4f7f\u62bd\u8c61\u7684\u9053\u5fb7\u502b\n\u7406\u9053\u7406(\u751f\u8207\u7fa9)\u8b8a\u5f97\u5177\u9ad4\u6dfa\u986f\u3001\u901a\u4fd7\u6613\u61c2,\u66f4\u5bb9\u6613\u8aaa\u670d\u8b80\u8005\u3002(2\u5206)"

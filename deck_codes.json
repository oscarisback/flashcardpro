    "ACZW2GW1": {
      "type": "folder",
      "name": "CHM",
      "created": "2026-08-23T22:10:32.411075",
      "data": {
        "folders": {},
        "decks": {
          "\u5fae\u89c0\u4e16\u754c(I)": [
            {
              "t": "Multiple Choice",
              "q": "\u4e0b\u5217\u54ea\u9805\u95dc\u65bc\u91d1\u5c6c\u9375\u7684\u63cf\u8ff0\u6700\u70ba\u6e96\u78ba",
              "a": "\u91d1\u5c6c\u967d\u96e2\u5b50\u8207\u96e2\u57df\u96fb\u5b50(\u96fb\u5b50\u6d77)\u4e4b\u9593\u7684\u975c\u96fb\u5f15\u529b",
              "o": [
                "\u91d1\u5c6c\u967d\u96e2\u5b50\u8207\u5171\u4eab\u96fb\u5b50\u5c0d\u4e4b\u9593\u7684\u975c\u96fb\u5f15\u529b",
                "\u91d1\u5c6c\u967d\u96e2\u5b50\u8207\u96e2\u57df\u96fb\u5b50(\u96fb\u5b50\u6d77)\u4e4b\u9593\u7684\u975c\u96fb\u5f15\u529b",
                "\u9670\u96e2\u5b50\u8207\u967d\u96e2\u5b50\u4e4b\u9593\u7684\u975c\u96fb\u5f15\u529b",
                "\u5206\u5b50\u8207\u5206\u5b50\u4e4b\u9593\u7684\u5fae\u5f31\u5206\u5b50\u9593\u529b"
              ],
              "e": "\u89e3\u6790:\u91d1\u5c6c\u9375\u7684\u5b9a\u7fa9\u70ba\u91d1\u5c6c\u967d\u96e2\u5b50\u8207\u81ea\u7531\u79fb\u52d5\u7684\u300c\u96e2\u57df\u96fb\u5b50\u6d77\u300d\u4e4b\u9593\u7684\u975c\u96fb\u5438\u5f15\u529b\u3002"
            },
            {
              "t": "Multiple Choice",
              "q": "\u4e0b\u5217\u54ea\u7a2e\u5206\u5b50\u7684\u7d50\u69cb\u4e2d\u542b\u6709\u5171\u50f9\u96d9\u9375?",
              "a": "\u4e8c\u6c27\u5316\u78b3 (CO2)",
              "o": [
                "\u6c2e\u6c23 (N2)",
                "\u7532\u70f7 (CH4)",
                "\u4e8c\u6c27\u5316\u78b3 (CO2)",
                "\u6c2f\u5316\u6c2b (HCl)"
              ],
              "e": "\u89e3\u6790:\u4e8c\u6c27\u5316\u78b3 (CO2) \u7684\u5206\u5b50\u7d50\u69cb\u70ba O=C=O,\u78b3\u539f\u5b50\u8207\u5169\u500b\u6c27\u539f\u5b50\u4e4b\u9593\u5747\u5f62\u6210\u5171\u50f9\u96d9\u9375\u3002N2 \u542b\u6709\u4e09\u9375,CH4 \u8207 HCl \u5747\u53ea\u6709\u55ae\u9375\u3002"
            },
            {
              "t": "Fill in Blank",
              "q": "\u7232\u4f55\u6c2f\u5316\u9209\u662f\u5805\u786c\u4e14\u6613\u788e\u7684\uff1f\n\u56e0\u7232\u6c2f\u5316\u9209\u5177{1:\u5de8\u578b\u96e2\u5b50\u7d50\u69cb}\uff0c\u5b83\u5b58\u6709{2:\u9209\u96e2\u5b50}\u53ca{3:\u6c2f\u96e2\u5b50}\u6240\u7d44\u6210\u7684{4:\u5f37\u5927\u96e2\u5b50\u9375}\u3002\u7531\u65bc\u96e2\u5b50{5:\u76f8\u5c0d\u79fb\u52d5}\u6642\u6703\u4f7f{6:\u76f8\u540c\u96fb\u8377\u7684\u96e2\u5b50}\u9760\u8fd1\uff0c\u6240\u4ee5\u5b83\u5011\u6703{7:\u4e92\u76f8\u6392\u65a5}"
            },
            {
              "t": "Multiple Choice",
              "q": "\u95dc\u65bc\u5143\u7d20\u9031\u671f\u8868\u4e2d\u9e75\u7d20\u7531\u4e0a\u81f3\u4e0b\u7684\u8da8\u52e2,\u4e0b\u5217\u54ea\u9805\u6558\u8ff0\u662f\u6b63\u78ba\u7684?",
              "a": "\u5143\u7d20\u7684\u7194\u9ede\u548c\u6cb8\u9ede\u9010\u6f38\u4e0a\u5347\u3002",
              "o": [
                "\u5143\u7d20\u7684\u7194\u9ede\u548c\u6cb8\u9ede\u9010\u6f38\u4e0a\u5347\u3002",
                "\u5143\u7d20\u7684\u5316\u5b78\u53cd\u61c9\u6027\u9010\u6f38\u589e\u52a0\u3002",
                "\u539f\u5b50\u7684\u6700\u5916\u5c64\u96fb\u5b50\u6578\u76ee\u9010\u6f38\u589e\u52a0\u3002",
                "\u5e38\u6eab\u5e38\u58d3\u4e0b\u7684\u7269\u7406\u72c0\u614b\u7531\u56fa\u614b\u8b8a\u70ba\u6c23\u614b\u3002"
              ],
              "e": "\u89e3\u6790:\u7b2c VII \u65cf(\u9e75\u7d20)\u6cbf\u65cf\u5411\u4e0b,\u5206\u5b50\u91cf\u53ca\u5206\u5b50\u5c3a\u5bf8\u589e\u5927,\u5206\u5b50\u9593\u7684\u7bc4\u5fb7\u83ef\u529b\u589e\u5f37,\u56e0\u6b64\u7194\u9ede\u548c\u6cb8\u9ede\u4e0a\u5347\u3002\u53cd\u61c9\u6027\u6cbf\u65cf\u5411\u4e0b\u6e1b\u5f31;\u6700\u5916\u5c64\u96fb\u5b50\u6578\u6046\u70ba 7;\u5e38\u6eab\u4e0b\u72c0\u614b\u7531\u6c23\u614b(F , Cl )\u8b8a\u70ba\u6db2\u614b(Br )\u518d\u8b8a\u70ba\u56fa\u614b(I )\u3002"
            },
            {
              "t": "Multiple Choice",
              "q": "\u4e0b\u5217\u54ea\u9805\u95dc\u65bcMgF2\u8207CCl4\u7194\u9ede\u6bd4\u8f03\u7684\u89e3\u91cb\u662f\u6b63\u78ba\u7684?",
              "a": "MgF2 \u7684\u7194\u9ede\u8f03\u9ad8,\u56e0\u70ba\u514b\u670d\u5de8\u578b\u6676\u9ad4\u5167\u7684\u96e2\u5b50\u9375\u6240\u9700\u7684\u80fd\u91cf\u9060\u9ad8\u65bc\u514b\u670d CCl \u5206\u5b50\u9593\u7684\u4f5c\u7528\u529b\u3002",
              "o": [
                "MgF2 \u7684\u7194\u9ede\u8f03\u9ad8,\u56e0\u70ba\u514b\u670d\u5de8\u578b\u6676\u9ad4\u5167\u7684\u96e2\u5b50\u9375\u6240\u9700\u7684\u80fd\u91cf\u9060\u9ad8\u65bc\u514b\u670d CCl \u5206\u5b50\u9593\u7684\u4f5c\u7528\u529b\u3002",
                "CCl4 \u7684\u7194\u9ede\u8f03\u9ad8,\u56e0\u70ba\u5171\u50f9\u9375\u5f37\u5ea6\u9ad8\u65bc\u96e2\u5b50\u9375\u3002",
                "\u5169\u8005\u7684\u7194\u9ede\u76f8\u76f8\u8fd1,\u56e0\u70ba\u5b83\u5011\u90fd\u542b\u6709\u975e\u91d1\u5c6c\u5143\u7d20\u3002",
                "MgF2 \u7684\u7194\u9ede\u8f03\u4f4e,\u56e0\u70ba\u91d1\u5c6c\u8207\u975e\u91d1\u5c6c\u7d50\u5408\u7684\u7a69\u5b9a\u6027\u8f03\u5dee\u3002"
              ],
              "e": "\u89e3\u6790:MgF2 \u70ba\u5de8\u578b\u96e2\u5b50\u7d50\u69cb,\u7194\u5316\u6642\u9700\u8981\u7834\u58de\u5f37\u70c8\u7684\u96e2\u5b50\u9375;CCl4 \u70ba\u7c21\u55ae\u5206\u5b50\u7d50\u69cb,\u7194\u5316\u6642\u50c5\u9700\u514b\u670d\u5fae\u5f31\u7684\u5206\u5b50\u9593\u529b(\u7bc4\u5fb7\u83ef\u529b),\u56e0\u6b64MgF2 \u7684\u7194\u9ede\u9060\u9ad8\u65bc CCl4 \u3002"
            },
            {
              "t": "Multiple Choice",
              "q": "\u5143\u7d20 P(\u539f\u5b50\u5e8f\u6578 12)\u8207\u5143\u7d20 Q(\u539f\u5b50\u5e8f\u6578 7)\u53cd\u61c9\u5f62\u6210\u5316\u5408\u7269\u3002\u8a72\u5316\u5408\u7269\u7684\u5316\u5b78\u5f0f\u662f\u751a\u9ebc?",
              "a": "P3Q2",
              "o": [
                "PQ",
                "P2Q3",
                "P3Q2",
                "P2Q"
              ],
              "e": "\u89e3\u6790:P(\u539f\u5b50\u5e8f\u6578 12,\u6392\u4f48 2,8,2)\u50be\u5411\u5931\u53bb 2 \u500b\u96fb\u5b50\u5f62\u6210 P2+ ;Q(\u539f\u5b50\u5e8f\u6578 7,\u6392\u4f48 2,5)\u50be\u5411\u5f97\u5230 3 \u500b\u96fb\u5b50\u5f62\u6210 Q3- \u3002\u6309\u96fb\u4e2d\u6027\u539f\u5247\u7d44\u5408,\u5316\u5b78\u5f0f\u70ba P Q \u3002"
            },
            {
              "t": "Multiple Choice",
              "q": "\u4e0b\u5217\u95dc\u65bc\u9e7c\u91d1\u5c6c\u7684\u63cf\u8ff0,\u54ea\u9805\u662f\u4e0d\u6b63\u78ba\u7684?",
              "a": "\u628a\u5b83\u5011\u653e\u5165\u6c34\u4e2d\u6642\u6703\u6c89\u5165\u6c34\u5e95\u4e26\u7a69\u5b9a\u6eb6\u89e3\u3002",
              "o": [
                "\u5b83\u5011\u80fd\u8207\u6c34\u53cd\u61c9\u7522\u751f\u6c2b\u6c23\u548c\u9e7c\u6027\u6eb6\u6db2\u3002",
                "\u6cbf\u65cf\u5411\u4e0b,\u91d1\u5c6c\u8207\u6c34\u53cd\u61c9\u7684\u5287\u70c8\u7a0b\u5ea6\u9010\u6f38\u589e\u52a0\u3002",
                "\u5b83\u5011\u901a\u5e38\u5bc6\u5ea6\u8f03\u4f4e,\u53ef\u7528\u5c0f\u5200\u5207\u958b\u3002",
                "\u628a\u5b83\u5011\u653e\u5165\u6c34\u4e2d\u6642\u6703\u6c89\u5165\u6c34\u5e95\u4e26\u7a69\u5b9a\u6eb6\u89e3\u3002"
              ],
              "e": "\u89e3\u6790:\u5e38\u898b\u9e7c\u91d1\u5c6c(Li, Na, K)\u5bc6\u5ea6\u5c0f\u65bc\u6c34,\u653e\u5165\u6c34\u4e2d\u6642\u6703\u6d6e\u65bc\u6c34\u9762\u4e0a\u4e26\u5287\u70c8\u53cd\u61c9(\u7522\u751f\u6c2b\u6c23\u53ca\u9e7c\u6027\u6c2b\u6c27\u5316\u7269\u6eb6\u6db2),\u800c\u975e\u6c89\u5165\u6c34\u5e95\u3002"
            },
            {
              "t": "Multiple Choice",
              "q": "\u4e0b\u5217\u54ea\u7a2e\u7269\u8cea\u5728\u56fa\u614b\u548c\u7194\u878d\u72c0\u614b\u4e0b\u5747\u4e0d\u80fd\u5c0e\u96fb?",
              "a": "\u4e59\u9187",
              "o": [
                "\u9435",
                "\u77f3\u58a8",
                "\u6c2f\u5316\u9209",
                "\u4e59\u9187"
              ],
              "e": "\u89e3\u6790:\u4e59\u9187\u70ba\u7c21\u55ae\u5206\u5b50\u5316\u5408\u7269,\u7121\u53ef\u81ea\u7531\u79fb\u52d5\u7684\u96e2\u5b50\u6216\u96fb\u5b50,\u56fa\u614b\u53ca\u7194\u878d\u614b\u5747\u4e0d\u5c0e\u96fb\u3002\u9435(\u91d1\u5c6c)\u5728\u5169\u614b\u4e0b\u5747\u80fd\u5c0e\u96fb;\u77f3\u58a8(\u5de8\u578b\u5171\u50f9)\u542b\u96e2\u57df\u96fb\u5b50\u53ef\u5c0e\u96fb;NaCl(\u96e2\u5b50\u5316\u5408\u7269)\u5728\u7194\u878d\u614b\u53ef\u5c0e\u96fb\u3002"
            },
            {
              "t": "Multiple Choice",
              "q": "\u5143\u7d20 X \u5728\u81ea\u7136\u754c\u4e2d\u6709\u5169\u7a2e\u540c\u4f4d\u7d20: 69X \u548c 71X\u3002\u82e5 69X \u7684\u76f8\u5c0d\u8c50\u5ea6\u70ba 60.0%,\u800c 71X \u7684\u76f8\u5c0d\u8c50\u5ea6\u70ba 40.0%, \u6c42 X \u7684\u76f8\u5c0d\u539f\u5b50\u8cea\u91cf\u3002",
              "a": "69.8",
              "o": [
                "69.6",
                "69.8",
                "70.0",
                "70.2"
              ],
              "e": "\u89e3\u6790:\u76f8\u5c0d\u539f\u5b50\u8cea\u91cf = \u52a0\u6b0a\u5e73\u5747\u503c = (69 \u00d7 60.0%) + (71 \u00d7 40.0%) = 41.4 + 28.4 = 69.8\u3002"
            },
            {
              "t": "Multiple Choice",
              "q": "\u4e0b\u5217\u54ea\u7d44\u5143\u7d20/\u7269\u8cea\u6700\u53ef\u80fd\u5177\u6709\u5de8\u578b\u5171\u50f9\u7d50\u69cb",
              "a": "\u947d\u77f3",
              "o": [
                "\u947d\u77f3",
                "\u6c2f\u5316\u9209",
                "\u6c34",
                "\u9382"
              ],
              "e": "\u89e3\u6790:\u947d\u77f3(\u78b3)\u900f\u904e\u5f37\u70c8\u7684\u5171\u50f9\u9375\u4ea4\u806f\u6210\u4e09\u7dad\u5de8\u578b\u5171\u50f9\u7d50\u69cb\u3002NaCl \u70ba\u5de8\u578b\u96e2\u5b50\u7d50\u69cb,H O \u70ba\u7c21\u55ae\u5206\u5b50\u7d50\u69cb,Mg \u70ba\u5de8\u578b\u91d1\u5c6c\u7d50\u69cb\u3002"
            },
            {
              "t": "Multiple Choice",
              "q": "\u67d0\u96e2\u5b50 Y3+ \u542b\u6709 10 \u500b\u96fb\u5b50\u548c 14 \u500b\u4e2d\u5b50\u3002\u4e0b\u5217\u54ea\u9805\u95dc\u65bc\u5143\u7d20 Y \u7684\u63cf\u8ff0\u662f\u6b63\u78ba\u7684?",
              "a": "Y \u7684\u8cea\u91cf\u6578\u70ba 27\u3002",
              "o": [
                "Y \u7684\u539f\u5b50\u5e8f\u6578\u70ba 10\u3002",
                "Y \u7684\u8cea\u91cf\u6578\u70ba 27\u3002",
                "Y \u4f4d\u65bc\u9031\u671f\u8868\u7684\u7b2c II \u65cf\u3002",
                "Y \u7684\u5916\u5c64\u96fb\u5b50\u6392\u4f48\u70ba 2,8\u3002"
              ],
              "e": "\u89e3\u6790:Y3+ \u96e2\u5b50\u542b\u6709 10 \u500b\u96fb\u5b50,\u4ee3\u8868\u4e2d\u6027 Y \u539f\u5b50\u5931\u53bb\u4e86 3 \u500b\u96fb\u5b50,\u6545 Y \u7684\u8cea\u5b50\u6578(\u539f\u5b50\u5e8f\u6578)\u70ba 10 + 3 = 13\u3002\u8cea\u91cf\u6578 = \u8cea\u5b50\u6578 + \u4e2d\u5b50\u6578 = 13 + 14 = 27\u3002\u96fb\u5b50\u6392\u4f48\u70ba 2,8,3,\u5c6c\u65bc\u7b2c III \u65cf\u3002"
            }
          ]
        }
      }
    }
  }
}